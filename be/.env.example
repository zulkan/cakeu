# Server Configuration
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=catatku
# Or use DATABASE_URL directly
# DATABASE_URL=postgres://postgres:change-me@localhost:5432/catatku?sslmode=disable

# JWT Configuration
JWT_SECRET=change-me-to-a-long-random-string

# SMTP Configuration (Sumopod: smtp.sumopod.com, port 465, SSL)
SMTP_HOST=smtp.sumopod.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=admin@example.com

# Frontend URL, used for password reset links and CORS
FRONTEND_URL=http://localhost:5173
