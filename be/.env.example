# Server Configuration
PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=catatku
# Or use DATABASE_URL directly
# DATABASE_URL=postgres://postgres:change-me@localhost:5432/catatku?sslmode=disable

# JWT Configuration
JWT_SECRET=change-me-to-a-long-random-string

# SMTP Configuration (Sumopod: smtp.sumopod.com, port 465, SSL)
SMTP_HOST=smtp.sumopod.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=admin@example.com

# Frontend URL, used for password reset links and CORS
FRONTEND_URL=http://localhost:5173

# Chat assistant (OpenAI-compatible). Server-side only; never expose to the browser.
# Leave LLM_API_KEY empty to disable chat (503) and make AI-first imports fall back to the
# strict header-only importer.
LLM_BASE_URL=https://api.cfrouter.com/v1
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024

# AI-first import. "ai" maps every CSV/XLSX/XLS with the LLM; "strict" keeps the old header-only importer.
SMART_IMPORT_MODE=ai
# How many rows of the selected sheet are sampled for the AI mapping (5-50).
SMART_IMPORT_SAMPLE_ROWS=30
